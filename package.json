{
  "name": "math-practice-house",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "test:print-edges": "node tests/print-edge.browser.mjs",
    "test:review-ui": "node tests/review-ui-regressions.mjs",
    "test:preview": "node tests/preview-smoke.mjs",
    "test:production": "node tests/production-v2.mjs",
    "test:pdf": "python3 tests/verify_pdf_v2.py",
    "test:audit": "python3 tests/audit_test.py",
    "test:font": "python3 tests/font_coverage.py",
    "audit:data": "python3 scripts/audit_source.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0"
  }
}
