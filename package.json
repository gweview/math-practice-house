{
  "name": "math-worksheet",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:layout": "node scripts/e2e-layout.mjs",
    "test:sudoku-layout": "node scripts/e2e-sudoku.mjs",
    "test:binary-reasoning-layout": "node scripts/e2e-binary-reasoning.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.18.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "playwright-core": "1.61.1",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.15.9"
}
